{
  "name": "agentic-poker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @poker/game-engine --filter @poker/auth --filter @poker/agent-orchestrator --filter @poker/web run dev",
    "build": "tsc -b && pnpm --filter @poker/web run build",
    "start": "pnpm --parallel --filter @poker/game-engine --filter @poker/auth --filter @poker/agent-orchestrator run start",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && tsc -p apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
