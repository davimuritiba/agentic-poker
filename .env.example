# Copie para .env (que não vai para o git) e ajuste.

# Qual IA o Coach usa: ollama (modelo local, grátis), claude (API paga) ou regras (sem IA).
# Sem esta linha: claude se houver ANTHROPIC_API_KEY, senão ollama.
COACH_PROVEDOR=ollama

# Modelo do coach. Padrão: qwen3:8b no Ollama, claude-opus-5-5 no Claude.
# COACH_MODELO=qwen3:8b

# Onde o Ollama está rodando (padrão: na mesma máquina).
# OLLAMA_URL=http://127.0.0.1:11434

# Quantas análises a IA faz ao mesmo tempo (padrão: 1 no Ollama, 4 no Claude)
# e quantas podem esperar na fila antes de cair no coach por regras (padrão: 4).
# COACH_CONCORRENCIA=1
# COACH_FILA_MAX=4

# Só para COACH_PROVEDOR=claude: chave da API da Anthropic.
# ANTHROPIC_API_KEY=
